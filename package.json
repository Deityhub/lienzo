{
	"name": "lienzo",
	"private": true,
	"version": "2.0.0",
	"author": {
		"name": "Chizoba Jude Ojini",
		"email": "contact@deityhub.com",
		"url": "https://judeojini.com"
	},
	"license": "GPL-3.0-only",
	"packageManager": "yarn@4.16.0",
	"engines": {
		"node": "22.x"
	},
	"type": "module",
	"scripts": {
		"dev": "svelte-kit sync && vite dev",
		"build": "svelte-kit sync && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "svelte-kit sync && vitest",
		"test:unit:run": "svelte-kit sync && vitest --run",
		"test:unit:coverage": "svelte-kit sync && vitest --run --coverage",
		"test": "yarn test:unit:run && yarn test:e2e",
		"brand:assets": "node scripts/generate-brand-assets.mjs",
		"test:e2e": "playwright test",
		"notices": "node scripts/generate-notices.mjs",
		"docs:screenshots": "yarn build && node scripts/generate-screenshots.mjs"
	},
	"devDependencies": {
		"@cantoo/pdf-lib": "^2.11.1",
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.22.0",
		"@lucide/svelte": "^0.548.0",
		"@playwright/test": "^1.49.1",
		"@sveltejs/adapter-node": "^5",
		"@sveltejs/adapter-vercel": "^5.6.3",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@tailwindcss/vite": "^4.0.0",
		"@types/node": "^22",
		"@vitest/browser": "^3.2.3",
		"@vitest/coverage-v8": "3.2.4",
		"eslint": "^9.22.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"html-to-image": "^1.11.13",
		"pdfjs-dist": "^6.5.438",
		"playwright": "^1.53.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.20.0",
		"vite": "^7.0.4",
		"vitest": "^3.2.3",
		"vitest-browser-svelte": "^0.1.0"
	},
	"dependencies": {
		"@cantoo/fontkit": "^2.0.12"
	}
}
